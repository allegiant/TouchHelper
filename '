use image::{DynamicImage, GenericImageView};
use rquickjs::{class::Trace, JsLifetime, Object, Result};
use std::sync::{Arc, Mutex};

// 引入您现有的核心滤镜和类型
use crate::domain::vision::filters::{
    BinarizationFilter, BinarizationMode, GrayscaleFilter, ResizeScaleFilter,
};
use crate::domain::vision::types::ImageFilterWrapper;

/// 脚本使用的图像对象
/// 对应 TS 中的: let img = device.capture();
#[derive(Trace, JsLifetime)]
#[rquickjs::class]
pub struct JsImage {
    // ✅ 修复：使用 skip_trace 告诉 GC 跳过纯 Rust 对象
    #[qjs(skip_trace)]
    inner: Arc<Mutex<DynamicImage>>,
}

impl JsImage {
    /// 构造函数 (供 Rust 内部调用，如 Device.capture)
    pub fn new(img: DynamicImage) -> Self {
        Self {
            inner: Arc::new(Mutex::new(img)),
        }
    }

    /// 获取内部图片的克隆 (如果需要传给其他 Rust 模块)
    pub fn inner_clone(&self) -> DynamicImage {
        self.inner.lock().unwrap().clone()
    }
}

#[rquickjs::methods]
impl JsImage {
    // ========================================================================
    // 1. 基础属性
    // ========================================================================

    #[qjs(get)]
    pub fn width(&self) -> u32 {
        self.inner.lock().unwrap().width()
    }

    #[qjs(get)]
    pub fn height(&self) -> u32 {
        self.inner.lock().unwrap().height()
    }

    // ========================================================================
    // 2. 图像处理 (经典 API)
    // ========================================================================

    /// 裁剪 (原地修改)
    /// TS: img.crop(100, 100, 200, 50)
    pub fn crop(&self, x: u32, y: u32, w: u32, h: u32) {
        let mut guard = self.inner.lock().unwrap();
        // 使用 image crate 的 crop_imm (immutable crop) 然后转回 DynamicImage
        let cropped = image::imageops::crop_imm(&*guard, x, y, w, h).to_image();
        *guard = DynamicImage::ImageRgba8(cropped);
    }

    /// 二值化
    /// TS: img.binarize(128)
    pub fn binarize(&self, threshold: i32) {
        // 1. 构造底层 Filter
        let filter = BinarizationFilter {
            mode: BinarizationMode::Manual,
            threshold_min: 0,
            threshold_max: threshold,
            is_rgb_avg: true,
            sauvola_k: 0.2,  // 默认参数
            window_size: 15, // 默认参数
        };
        // 2. 包装并执行
        self.apply_filter_internal(ImageFilterWrapper::Binarization(filter));
    }

    /// 灰度化
    /// TS: img.grayscale()
    pub fn grayscale(&self) {
        self.apply_filter_internal(ImageFilterWrapper::Grayscale(GrayscaleFilter {}));
    }

    /// 缩放
    /// TS: img.resize(100, 100)
    pub fn resize(&self, w: i32, h: i32) {
        let filter = ResizeScaleFilter {
            target_width: w,
            target_height: h,
            mode: ResizeMode::Exact,
        };
        self.apply_filter_internal(ImageFilterWrapper::ResizeScale(filter));
    }

    // ========================================================================
    // 3. 高级功能 (OCR Grid)
    // ========================================================================

    /// 网格识别 (经典按键精灵风格)
    /// TS: img.ocrGrid(0, 0, 20, 20, 0, 5, fontLib, 0.8)
    /// library: { "1": "0101...", "2": "..." }
    pub fn ocr_grid(
        &self,
        start_x: u32,
        start_y: u32,
        w: u32,
        h: u32,
        gap: u32,
        count: u32,
        library: Object<'_>, // JS 传来的字库对象
        min_conf: f32,
    ) -> Result<String> {
        let guard = self.inner.lock().unwrap();
        let mut result_str = String::new();

        // 1. 解析 JS 字库到 Rust (Char -> FeatureString)
        let mut rust_lib: Vec<(String, String)> = Vec::new();
        for (key, val) in library.iter() {
            let char_str: String = key?;
            let feat_str: String = val.try_into()?; // 尝试转换值为 String
            rust_lib.push((char_str, feat_str));
        }

        // 2. 循环切割与匹配
        for i in 0..count {
            let x = start_x + i * (w + gap);
            // 越界保护
            if x + w > guard.width() {
                break;
            }

            // 2.1 切出单字 (不修改原图)
            let sub_img = image::imageops::crop_imm(&*guard, x, start_y, w, h);

            // 2.2 缩放归一化 (可选，这里假设字库是按 w*h 生成的，不做 resize)
            // 如果需要鲁棒性，建议 resize 到固定特征尺寸 (如 16x16 或 32x32)
            // let resized = image::imageops::resize(&sub_img, w, h, image::imageops::FilterType::Triangle);

            // 2.3 提取特征 (调用 core/domain/vision/analysis.rs)
            // 注意：这里需要 sub_img 是 DynamicImage 或者 ImageBuffer
            let sub_dynamic = DynamicImage::ImageRgba8(sub_img.to_image());
            let feature = generate_binary_feature(&sub_dynamic);

            // 2.4 暴力匹配
            let mut best_char = "";
            let mut max_score = 0.0;

            for (ch, lib_feat) in &rust_lib {
                let score = calculate_similarity(&feature, lib_feat);
                if score > max_score {
                    max_score = score;
                    best_char = ch;
                }
            }

            // 2.5 阈值判断
            if max_score >= min_conf {
                result_str.push_str(best_char);
            }
        }

        Ok(result_str)
    }

    // ========================================================================
    // 4. 私有辅助方法
    // ========================================================================

    /// 统一执行滤镜的 Helper
    /// 复用 `types.rs` 中定义的 `ImageFilterWrapper::apply`
    fn apply_filter_internal(&self, wrapper: ImageFilterWrapper) {
        let mut guard = self.inner.lock().unwrap();

        // 调用底层算法 (domain/vision/filters)
        match wrapper.apply(&guard) {
            Ok(processed) => {
                *guard = processed; // 更新当前状态
            }
            Err(e) => {
                // 在脚本环境中，可以选择打印日志或者忽略错误
                // 如果想抛出 JS 异常，可以将返回值改为 Result<()>
                eprintln!("Filter execution failed: {}", e);
            }
        }
    }
}

// 简单的字符串相似度比对 (Hamming distance 变种)
// 假设 feature 是 "010101" 字符串
fn calculate_similarity(s1: &str, s2: &str) -> f32 {
    let len = s1.len().min(s2.len());
    if len == 0 {
        return 0.0;
    }

    let mut match_count = 0;
    // 逐字符比较
    for (c1, c2) in s1.chars().zip(s2.chars()) {
        if c1 == c2 {
            match_count += 1;
        }
    }

    match_count as f32 / len as f32
}
